{
  "name": "@tally/server",
  "version": "0.1.0",
  "description": "Tally API: untrusted transport, index and read model for signed ledger logs, on Node + PostgreSQL",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "recheck": "node dist/recheck.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@nimiq/core": "^2.7.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tally/core": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
